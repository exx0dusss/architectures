{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(bun run lint*)",
      "Bash(bun run build*)",
      "Bash(bun run test*)",
      "Bash(bun run dev*)",
      "Bash(bun install*)",
      "Bash(bunx tsc*)",
      "Bash(npx tsc*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)"
